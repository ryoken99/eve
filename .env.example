# Optional per-machine Eve settings.
# Copy to .env only if a launcher/tool explicitly loads it.

# Override external entity memory import folder.
# EVE_ENTITIES_MEMORY_DIR=D:\entities\memoria para  as entidades

# Optional alternate audit directory.
# EVE_AUDIT_DIR=E:\eve\logs\audit

# Optional transcript directory.
# EVE_TRANSCRIPTS_DIR=E:\eve\logs\transcripts
